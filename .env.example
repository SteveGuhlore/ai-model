# Copy to .env and adjust. All values have sane defaults (see config.py).

# Paths
AVATAR_WORK_DIR=outputs
AVATAR_FACE_IMAGE=assets/face.png
AVATAR_MODELS_DIR=models

# Persona / local LLM brain
AVATAR_LLM_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
AVATAR_PERSONA_NAME=Ava

# Voice (XTTS-v2). Use only your own / consented voice for the reference clip.
AVATAR_TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
AVATAR_VOICE_SAMPLE=assets/voice_ref.wav
AVATAR_TTS_LANGUAGE=en

# Face generation (safety-tuned base + your likeness LoRA)
AVATAR_SDXL_BASE=stabilityai/stable-diffusion-xl-base-1.0
AVATAR_LORA_PATH=models/likeness-lora.safetensors

# Talking head
SADTALKER_DIR=third_party/SadTalker

# Safety
AVATAR_NSFW_CLASSIFIER=Falconsai/nsfw_image_detection
AVATAR_NSFW_THRESHOLD=0.7

# Adult-mode policy spine. Disabled by default. Existing SFW endpoints ignore this.
# Adult workflows must still require consent, age verification, AI disclosure,
# platform eligibility, and human review before delivery.
AVATAR_ADULT_MODE_ENABLED=false
AVATAR_ADULT_ALLOWED_PLATFORMS=fanvue,telegram
AVATAR_ADULT_REQUIRE_HUMAN_REVIEW=true

# Hosted generation provider for the creator content channels.
# "fal" = fal.ai (needs FAL_KEY); "fake" = in-memory provider for local/dev/tests.
AVATAR_PROVIDER=fal
FAL_KEY=

# Storage (local-first; structured to move to Postgres + object storage later)
AVATAR_DB_URL=sqlite:///creator.db
AVATAR_MEDIA_DIR=media
AVATAR_STORAGE=local

# Compute
AVATAR_DEVICE=cuda

